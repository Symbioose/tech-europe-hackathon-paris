# All keys are optional. Without them Crucible runs from the deterministic Oura fallback session.
# Live mode kicks in when a non-Oura URL is provided AND the corresponding key is set.

# OpenAI — product summary, tribe generation, persona Q&A, learning synthesis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tavily — competitor + trend signals
TAVILY_API_KEY=

# fal — winning short-form video creative for the recommendation
FAL_KEY=

# Gradium — hero buyer voice response
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=claire-eu

# Force the deterministic fallback even with live keys (set 1 for safe demo recording).
CRUCIBLE_DEMO_MODE=

# Pioneer (future extension) — would fine-tune a reaction classifier (intent +
# objection + confidence). Not used by the current demo. Leaving the env var
# documented here in case the wrapper at lib/integrations/pioneer.ts is wired
# up in a future iteration.
# PIONEER_API_KEY=
